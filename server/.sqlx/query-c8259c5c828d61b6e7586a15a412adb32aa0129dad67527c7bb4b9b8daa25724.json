{
  "db_name": "PostgreSQL",
  "query": "SELECT message_id, content, queued_at\n           FROM message_queue\n           WHERE recipient_id = $1 AND queued_at <= $2\n             AND (queued_at, message_id) > ($3, $4)\n           ORDER BY queued_at, message_id\n           LIMIT $5",
